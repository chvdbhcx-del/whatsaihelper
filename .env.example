# ---------- Сервер ----------
PORT=3000
# Пароль для панели оператора (логин: admin)
ADMIN_PASSWORD=смените-меня

# ---------- ngrok (публичный адрес без своего сервера) ----------
# Токен: https://dashboard.ngrok.com/get-started/your-authtoken . Пусто = ngrok не запускается
NGROK_AUTHTOKEN=
# Бесплатный постоянный домен из кабинета ngrok (Domains), например abc-xyz.ngrok-free.app
NGROK_DOMAIN=

# ---------- WhatsApp ----------
# Провайдер:
#   web       — обычный WhatsApp, вход по QR в панели оператора (неофициально, риск блокировки номера!)
#   360dialog | meta | custom — официальный WhatsApp Business API через партнёра
WA_PROVIDER=web

# 360dialog: ключ API из личного кабинета партнёра
D360_API_KEY=

# meta: прямой Cloud API (если когда-нибудь перейдёте напрямую)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
# Секрет приложения Meta: проверка подписи вебхука (рекомендуется для meta)
META_APP_SECRET=

# custom: любой партнёр с API в формате Cloud API
CUSTOM_SEND_URL=
CUSTOM_AUTH_HEADER=Authorization
CUSTOM_AUTH_VALUE=

# Токен для проверки вебхука (GET /webhook?hub.verify_token=...)
WEBHOOK_VERIFY_TOKEN=придумайте-строку
# Необязательный секрет в адресе вебхука: /webhook?key=... (для партнёров без подписи)
WEBHOOK_KEY=

# true = ничего не отправлять в WhatsApp, только писать в лог (для теста)
WA_DRY_RUN=false

# ---------- ИИ ----------
# Всё это можно настроить в панели оператора. Значения из панели важнее, чем здесь.
# anthropic = Claude; openai = любой сервис с API в формате OpenAI (Gemini, Groq, OpenRouter, Ollama)
AI_PROVIDER=anthropic
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Ключ можно не писать здесь, а ввести в панели оператора
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high. Для живого чата low обычно достаточно и отвечает быстрее
AI_EFFORT=low
# Сколько последних сообщений диалога передавать модели
AI_HISTORY=30
# true = вместо Claude отвечает заглушка (для локального теста без ключа)
AI_MOCK=false

# ---------- Поведение ----------
# Лимит ответов бота за сутки по умолчанию для каждого номера (0 = без лимита). У каждого номера меняется в панели
DAILY_REPLY_LIMIT=100
# Ждать N секунд после последнего сообщения клиента (клиенты часто пишут несколькими сообщениями)
REPLY_DEBOUNCE_SECONDS=4
# Если оператор писал в чат, бот молчит N минут
HUMAN_PAUSE_MINUTES=60
