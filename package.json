{
  "name": "whatsapp-ai-assistant",
  "version": "1.9.3",
  "description": "ИИ-ассистент техподдержки для WhatsApp (официальный Cloud API через BSP) с панелью оператора",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "simulate": "node test/simulate.js",
    "loadtest": "node test/loadtest.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@ngrok/ngrok": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^44.11.5",
    "electron-builder": "^26.18.0"
  },
  "productName": "WhatsApp AI Assistant",
  "build": {
    "appId": "local.whatsapp.ai.assistant",
    "productName": "WhatsApp AI Assistant",
    "asar": false,
    "files": [
      "src/**",
      "public/**",
      "knowledge/**",
      "desktop/**",
      "package.json",
      "!node_modules/@ngrok/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ИИ-ассистент WhatsApp",
      "artifactName": "WhatsApp-AI-Assistant-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chvdbhcx-del",
        "repo": "whatsaihelper",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chvdbhcx-del/whatsaihelper.git"
  }
}
